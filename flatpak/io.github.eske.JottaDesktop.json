{
  "app-id": "io.github.eske.JottaDesktop",
  "runtime": "org.gnome.Platform",
  "runtime-version": "48",
  "sdk": "org.gnome.Sdk",
  "command": "jotta-desktop",
  "finish-args": [
    "--share=network",
    "--socket=session-bus",
    "--filesystem=host",
    "--filesystem=xdg-run/jottad",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "modules": [
    {
      "name": "jotta-desktop",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --offline -p jotta-gui -p jotta-tray",
        "install -Dm755 target/release/jotta-desktop /app/bin/jotta-desktop",
        "install -Dm755 target/release/jotta-tray /app/bin/jotta-tray",
        "install -Dm644 data/jotta-desktop.desktop /app/share/applications/jotta-desktop.desktop",
        "install -Dm644 data/autostart/jotta-tray.desktop /app/share/applications/jotta-tray.desktop",
        "install -Dm644 data/io.github.eske.JottaDesktop.metainfo.xml /app/share/metainfo/io.github.eske.JottaDesktop.metainfo.xml",
        "cp -r data/icons/hicolor /app/share/icons/",
        "gtk-update-icon-cache -f -t /app/share/icons/hicolor || true"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".."
        }
      ]
    },
    {
      "name": "jotta-cli",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 jotta-cli /app/bin/jotta-cli",
        "install -Dm755 jottad /app/bin/jottad"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://repo.jotta.cloud/downloads/linux/x64/jotta-cli-<version>.tar.gz",
          "sha256": "TBD"
        }
      ]
    }
  ]
}
